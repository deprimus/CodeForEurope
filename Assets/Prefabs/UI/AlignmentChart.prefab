  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Progressivism is an alignment driven by the advancement of social justice
    and systemic reform. It views history as a movement toward greater equality and
    believes that traditional institutions are often flawed or discriminatory. Progressives
    advocate for using the power of the state or collective action to dismantle perceived
    inequities and improve the living conditions of marginalized groups.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
